# Example configuration. Copy to .env and edit to override defaults.
# All keys are optional — anything omitted falls back to the built-in default.

# Which transport the producer/consumer use: "kafka" (default) or "memory".
TRANSPORT=kafka

# Kafka connection (used when TRANSPORT=kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions

# Model + persistence artifacts
MODEL_PATH=consumer/model.pkl
EXPLAINER_PATH=consumer/explainer.pkl
DB_PATH=fraud_results.db

# Streamlit dashboard port
DASHBOARD_PORT=8501
